{
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-shell-escape",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ],
      "env": {
        "PATH": "C:\\Users\\Alexeido\\AppData\\Local\\Programs\\Python\\Python313;C:\\Users\\Alexeido\\AppData\\Local\\Programs\\Python\\Python313\\Scripts;${env:PATH}"
      }
    },
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "-shell-escape",
        "%DOC%"
      ],
      "env": {
        "PATH": "C:\\Users\\Alexeido\\AppData\\Local\\Programs\\Python\\Python313;C:\\Users\\Alexeido\\AppData\\Local\\Programs\\Python\\Python313\\Scripts;${env:PATH}"
      }
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex ➜ pdf",
      "tools": [
        "pdflatex"
      ]
    },
    {
      "name": "latexmk ➜ pdf",
      "tools": [
        "latexmk"
      ]
    }
  ],
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.linting.excludePattern": "**/_minted/**,**/*.aux,**/*.bbl,**/*.blg,**/*.fdb_latexmk,**/*.fls,**/*.maf,**/*.mtc*,**/*.toc",
